# Indiana Law MCP — environment variables
# Copy to ~/.indiana-law-env and fill in values.
# DO NOT commit this file with real values.

# IGA API token (free — email apitoken.request@iga.in.gov)
IGA_API_TOKEN=

# CourtListener API key (optional — free tier = 125 calls/day, sufficient for daily Indiana sync)
# Paid tiers: $10/mo = 600/day, $25/mo = 150/hr
# https://free.law/membership/
COURTLISTENER_API_KEY=

# Override default database path (optional)
# INDIANA_LAW_DB=/path/to/indiana_law.db
