[Unit]
Description=Cloudflare tunnel for mcp.indianacle.com
After=network-online.target indiana-code-mcp.service
Wants=network-online.target

[Service]
Type=simple
User=transcribe
Group=transcribe
ExecStart=/usr/local/bin/cloudflared tunnel --no-autoupdate --config /home/transcribe/.config/indiana-code/cloudflared.yml run
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
